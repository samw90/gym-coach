#!/bin/sh
# Stamps the build date and revision (commit count, including this commit) into index.html.
f=index.html
[ -f "$f" ] || exit 0
rev=$(( $(git rev-list --count HEAD 2>/dev/null || echo 0) + 1 ))
day=$(date +%Y-%m-%d)
sed -i.bak -E "s/^const BUILD = \{[^}]*\};/const BUILD = {date:\"$day\", rev:$rev};/" "$f" && rm -f "$f.bak"
git add "$f"
